{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/zooraze/godot-cpp/blob/master/release/schemas/release-manifest-v1.schema.json",
  "title": "godot-cpp immutable release manifest v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "tag", "source_commit", "expected_matrix", "packages", "assets"],
  "properties": {
    "schema_version": {"const": 1}, "tag": {"type": "string", "minLength": 1}, "source_commit": {"$ref": "#/$defs/gitSha"},
    "expected_matrix": {"type": "array", "uniqueItems": true, "items": {"type": "string"}},
    "packages": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["matrix_id", "package_id", "filename", "sha256", "size", "sbom", "provenance_attestation", "sbom_attestation"],
        "properties": {
          "matrix_id": {"type": "string"}, "package_id": {"type": "string"}, "filename": {"type": "string"}, "sha256": {"$ref": "#/$defs/sha256"}, "size": {"type": "integer", "minimum": 1},
          "sbom": {"type": "string"}, "provenance_attestation": {"type": "string"}, "sbom_attestation": {"type": "string"}
        }
      }
    },
    "assets": {
      "type": "array", "items": {"type": "object", "additionalProperties": false, "required": ["filename", "sha256", "size"], "properties": {"filename": {"type": "string"}, "sha256": {"$ref": "#/$defs/sha256"}, "size": {"type": "integer", "minimum": 1}}}
    }
  },
  "$defs": {"sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}, "gitSha": {"type": "string", "pattern": "^[0-9a-f]{40}$"}}
}
